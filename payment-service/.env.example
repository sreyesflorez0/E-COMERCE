PORT=8086
DATABASE_URL=postgresql+asyncpg://postgres:postgres@payment-db:5432/payment_db
JWT_SECRET=ecommerce-super-secret-jwt-key-change-this-in-production-must-be-256-bits
JWT_ALGORITHM=HS512
ORDER_SERVICE_URL=http://order-service:8084
PAYMENT_ALLOW_UNVERIFIED_ORDERS=true
ENABLE_RABBITMQ=false
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=ecommerce.events
RABBITMQ_PAYMENT_COMPLETED_ROUTING_KEY=payment_completed
RABBITMQ_PAYMENT_FAILED_ROUTING_KEY=payment_failed
