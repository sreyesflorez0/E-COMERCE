PORT=8087
MONGO_URI=mongodb://notification-db:27017
MONGO_DB=notification_db
JWT_SECRET=ecommerce-super-secret-jwt-key-change-this-in-production-must-be-256-bits
JWT_ALGORITHM=HS512
ENABLE_RABBITMQ=false
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=ecommerce.events
RABBITMQ_QUEUE=notification_service_queue
RABBITMQ_ROUTING_KEYS=cart_updated,order_created,order_confirmed,payment_completed,payment_failed
ENABLE_NOTIFICATION_SENT_EVENT=false
RABBITMQ_NOTIFICATION_SENT_ROUTING_KEY=notification_sent
