# ============================================
# SERVERLESS REPORTING SERVICE — ENVIRONMENT CONFIG
# ============================================
# Copiar este archivo como .env antes de ejecutar
# cp .env.example .env

# ---- Reporting Service Database (propia) ----
REPORTING_DB_HOST=localhost
REPORTING_DB_PORT=5437
REPORTING_DB_NAME=reporting_db
REPORTING_DB_USER=reporting_user
REPORTING_DB_PASSWORD=reporting_pass

# ---- Order Service Database (read-only) ----
# Se conecta a la base de datos del Order Service existente
# para consultar órdenes y calcular métricas
ORDER_DB_HOST=localhost
ORDER_DB_PORT=5436
ORDER_DB_NAME=order_db
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=order_pass

# ---- JWT Configuration ----
# Debe coincidir con el JWT_SECRET del Auth Service
JWT_SECRET=ecommerce-super-secret-jwt-key-change-this-in-production-must-be-256-bits
# Algoritmo: HS512 (coincide con JJWT Keys.hmacShaKeyFor con clave >= 64 bytes)
JWT_ALGORITHM=HS512
