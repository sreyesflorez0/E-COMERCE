PORT=8080
NODE_ENV=development

# JWT Configuration
JWT_SECRET=ecommerce-super-secret-jwt-key-change-this-in-production-must-be-256-bits

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Service URLs
AUTH_SERVICE_URL=http://auth-service:8081
USER_SERVICE_URL=http://user-service:8082
PRODUCT_SERVICE_URL=http://product-service:8083
ORDER_SERVICE_URL=http://order-service:8084
REPORTING_SERVICE_URL=http://host.docker.internal:3000

# Proxy Timeout
PROXY_TIMEOUT_MS=30000

# RabbitMQ (Prepared but disabled by default)
ENABLE_RABBITMQ=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_REPORT_QUEUE=report_requested
